\def\MagicHaskellLiterates{}
\newcommand\AddMagicLiterate[3][\magicLink]{%
   \AddMagicLiterateX[#1]{#2}{#3}{#3}%
}
\newcommand\AddMagicLiterateX[4][\magicLink]{%
   \StrLen{#3}[\@cclen]%
   \xappto\MagicHaskellLiterates{\unexpanded{{#3}{{{#1{#2}{#4}}}}}{\@cclen}}%
}

\newcommand\AddMagicLiterateP[4][\magicLink]{%
\xappto\MagicHaskellLiterates{\unexpanded{{#3}{{{#1{#2}{#3}}}}}{#4}}%
}

