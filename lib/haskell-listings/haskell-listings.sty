% copy fix ligatures:
\protected\def\commLig{\HaskellPrompt{\BeginAccSupp{ActualText={|>}}|>\EndAccSupp{}}}
\protected\def\dcommLig{\HaskellPrompt{\BeginAccSupp{ActualText={||>}}|\kern-3.5pt|>\EndAccSupp{}}}
\protected\def\funcLig{\HaskellPrompt{\BeginAccSupp{ActualText={<$>}}<\$>\EndAccSupp{}}}
\protected\def\lfuncLig{\HaskellPrompt{\BeginAccSupp{ActualText={<$}}<\$\EndAccSupp{}}}
\protected\def\starLig{\HaskellPrompt{\BeginAccSupp{ActualText={<*>}}<*>\EndAccSupp{}}}
\protected\def\implLig{\HaskellPrompt{\BeginAccSupp{ActualText={={}={}>}}==>\EndAccSupp{}}} % \(\implies\)
\protected\def\theLig{\BeginAccSupp{ActualText={>>=}}>>=\EndAccSupp{}}
\protected\def\ppLig{\BeginAccSupp{ActualText={++}}++\EndAccSupp{}}
\protected\def\pppLig{\BeginAccSupp{ActualText={+++}}+++\EndAccSupp{}}
% \protected\def\spaceLig{\BeginAccSupp{ActualText={ }} \EndAccSupp{}}
\protected\def\kleisliLig{\BeginAccSupp{ActualText={>{}={}>}}>=>\EndAccSupp{}}
\protected\def\toLig{\BeginAccSupp{ActualText={->}}->\EndAccSupp{}}
\protected\def\leqLig{\BeginAccSupp{ActualText={<=}}<=\EndAccSupp{}}
\protected\def\geqLig{\BeginAccSupp{ActualText={>=}}>=\EndAccSupp{}}
\protected\def\otLig{\BeginAccSupp{ActualText={<-}}<-\EndAccSupp{}}
\protected\def\ToLig{\BeginAccSupp{ActualText={=>}}=>\EndAccSupp{}}
\protected\def\colLig{\BeginAccSupp{ActualText={::}}::\EndAccSupp{}}
\protected\def\neqLig{\BeginAccSupp{ActualText={/=}}/=\EndAccSupp{}}
\protected\def\andLig{\BeginAccSupp{ActualText={&&}}\&\&\EndAccSupp{}}
\protected\def\orLig{\BeginAccSupp{ActualText={||}}||\EndAccSupp{}}
\protected\def\altLig{\BeginAccSupp{ActualText={<{}|{}>}}\HaskellPrompt{<\kern-1pt|\kern-1pt>}\EndAccSupp{}} % forcefully break the lig
\protected\def\dotInvLig{\BeginAccSupp{ActualText={..}}..\EndAccSupp{}}
\protected\def\tredotInvLig{\BeginAccSupp{ActualText={...}}...\EndAccSupp{}}


