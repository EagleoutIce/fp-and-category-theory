  {->}{{\toLig}}2 {=>}{{\ToLig}}2 {::}{{\colLig}}2 {/=}{{\neqLig}}2%
  {\&\&}{{\andLig}}2 {||}{{\orLig}}2 {<-}{{\otLig}}2 {<$}{{\lfuncLig}}2 {<$>}{{\funcLig}}3%
  {<*>}{{\starLig}}3{<=}{{\leqLig}}2 {>=}{{\geqLig}}2 {>>=}{{\theLig}}3 {>=>}{{\kleisliLig}}3%
