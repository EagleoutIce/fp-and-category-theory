% configure the main style
\lstdefinestyle{hs@main}{%
   lineskip     = .33pt, % minor increase in spacing
   xleftmargin  = \hs@length@lst@xleftmargin,
   xrightmargin = \hs@length@lst@xrightmargin,
   % the 'key'-styles:
   stringstyle  = \hs@styles@lst@basic\hs@styles@lst@literals,
   commentstyle = \hs@styles@lst@basic\hs@styles@lst@comments,
   keywordstyle = \hs@styles@lst@basic\hs@styles@lst@keywordA,
   keywordstyle = [2]{\hs@styles@lst@basic\hs@styles@lst@keywordB},
   keywordstyle = [3]{\hs@styles@lst@basic\hs@styles@lst@keywordC},
   keywordstyle = [4]{\hs@styles@lst@basic\hs@styles@lst@keywordD},
   basicstyle   = \hs@styles@lst@basic,
   % line numbers:
   numbers      = left, numbersep = \hs@length@lst@numsep,
   numberstyle  = \hs@styles@lst@basic\hs@styles@lst@linenumbers\hs@lst@num@consume,
   % line break:
   breaklines   = true, extendedchars = true,
   % TODO: \XC@nummixins0\hbox{\textcolor{hs@colors@lst@comments}{\codeprebreak}}
   prebreak     = \rlap{\hs@font@fs@numbers$\hookleftarrow$},
   % escapes:
   % escapeinside = {\{->}{\}},
   escapeinside = {--\ !*}{*!},
   % space control
   keepspaces=false
}

% lst deep injects a fi
\def\hs@escape@collector@init{\begingroup\def\hs@@escape@collector@{\iftrue}\hs@escape@collector}
\def\hs@escape@collector@consume#1{\appto\hs@@escape@collector@{#1}\hs@escape@collector}
\def\@hs@escape@collector{%
%if the meaning of the char contains '\lst@escapeend' with a macro definition we are done!
% \typeout{{\noexpand\lst@escapeend}{\@search}}
\expandarg\IfSubStr*{\meaning\@escape@lookahead}{\noexpand\lst@escapeend}{%
% \typeout{YES}% emit the collectio
   \global\let\@hs@escape@collected\hs@@escape@collector@\endgroup
   \hs@escape@aftercollect
}{%
   \hs@escape@collector@consume
}%
}

\def\hs@escape@collector{%
   \futurelet\@escape@lookahead\@hs@escape@collector
}
