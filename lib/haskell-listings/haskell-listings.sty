% The basic literate table
\def\HsSetLiterateTable{%
  \lstset{basewidth=0.6em,add to literate=%
  % i do not think, that we need them
  % {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1 {à}{{\`a}}1 {è}{{\`e}}1 {ì}{{\`i}}1
  % {ò}{{\`o}}1 {ù}{{\`u}}1 {À}{{\`A}}1 {È}{{\'E}}1 {Ì}{{\`I}}1 {Ò}{{\`O}}1
  % {Ù}{{\`U}}1 {ë}{{\"e}}1 {ï}{{\"i}}1 {Ë}{{\"E}}1 {Ï}{{\"I}}1
  {ä}{{\"a}}1 {ö}{{\"o}}1 {ü}{{\"u}}1 {Ä}{{\"A}}1 {Ö}{{\"O}}1 {Ü}{{\"U}}1
  % {â}{{\^a}}1 {ê}{{\^e}}1 {î}{{\^i}}1 {ô}{{\^o}}1 {û}{{\^u}}1 {æ}{{\ae}}1
  % {Æ}{{\AE}}1
  {ø}{{\o}}1 {ß}{{\ss}}1 {€}{{\texteuro}}1 {£}{{\pounds}}1
  % those can be used as "breakers" in case highlights or replacements fail
  {:ws:}{{{ }}}1 {:c:}{{{}}}0 {:star:}{{*}}1 {:minus:}{{-}}1  {:ul:}{{\_}}1
  % generic ones, which i like
  {:yields:}{{{$\rightarrow$}}}1 {:lan:}{{{$\langle$\thinspace}}}1
  {:ran:}{{{\thinspace$\rangle$}}}1 {:to:}{{{$\to$}}}2 {:equiv:}{{{$\equiv$}}}1
  {:~>:}{{{$\rightsquigarrow$}}}1
  % numbeeeeers!
  {0}{{\hs@dgt{0}}}1
  {1}{{\hs@dgt{1}}}1 {2}{{\hs@dgt{2}}}1 {3}{{\hs@dgt{3}}}1
  {4}{{\hs@dgt{4}}}1 {5}{{\hs@dgt{5}}}1 {6}{{\hs@dgt{6}}}1
  {7}{{\hs@dgt{7}}}1 {8}{{\hs@dgt{8}}}1 {9}{{\hs@dgt{9}}}1
  {0e}{{\hs@dgt{0e}}}2
  {1e}{{\hs@dgt{1e}}}2 {2e}{{\hs@dgt{2e}}}2 {3e}{{\hs@dgt{3e}}}2
  {4e}{{\hs@dgt{4e}}}2 {5e}{{\hs@dgt{5e}}}2 {6e}{{\hs@dgt{6e}}}2
  {7e}{{\hs@dgt{7e}}}2 {8e}{{\hs@dgt{8e}}}2 {9e}{{\hs@dgt{9e}}}2
  {.0}{{\hs@dgt{.0}}}2
