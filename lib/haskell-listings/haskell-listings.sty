% make custom ligatures
\usepackage{xstring}
\def\hsinlinetypewrap#1{% get those ligatures
   \protected@edef\@tmp@typeout{#1}%
   \StrSubstitute{\@tmp@typeout}{->}{\texttt{\toLig}}[\@tmp@typeout]%
   \StrSubstitute{\@tmp@typeout}{=>}{\texttt{\ToLig}}[\@tmp@typeout]%
   \StrSubstitute{\@tmp@typeout}{::}{\texttt{\colLig}}[\@tmp@typeout]%
   \textsf{\tiny\color{gray}\@tmp@typeout}%
}%
