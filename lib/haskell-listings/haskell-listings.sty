\newif\ifhs@lst@lastwas@character@ % last segment was from char-class
\newif\ifhs@lst@lastwas@charkeep@  % in char-mode (pass through)
% we should care about number highlighting:
\def\hs@@lst@hl@digit#1{\begingroup
\ifhs@lst@lastwas@character@
\global\hs@lst@lastwas@charkeep@true#1\else\global\hs@lst@lastwas@charkeep@false
  \ifnum\lst@mode=\lst@Pmode\relax% PMode: Not in any special Mode
  {\hs@styles@lst@numbers{#1}}% or if keywords are active:
  \else\lst@ifkeywords{\hs@styles@lst@numbers{#1}}\else#1\fi\fi
\fi
\endgroup}
\let\hs@dgt\hs@@lst@hl@digit
\def\hsdisablenumhl{\def\hs@dgt##1{##1}}
\def\hsenablenumhl{\let\hs@dgt\hs@@lst@hl@digit}

% overwrite processor routines to adapt to number
\def\lst@ProcessLetter{%
  \lst@whitespacefalse\hs@lst@lastwas@character@true\lst@AppendLetter}
\def\lst@ProcessOther{%
  \lst@whitespacefalse\hs@lst@lastwas@charkeep@false\hs@lst@lastwas@character@false\lst@AppendOther}
\def\lst@whitespacetrue{\ifhs@lst@lastwas@charkeep@\hs@lst@lastwas@charkeep@false\hs@lst@lastwas@character@false\else\hs@lst@lastwas@character@false\fi\global\let\lst@ifwhitespace\iftrue}
\def\lst@whitespacefalse{\global\let\lst@ifwhitespace\iffalse}

\def\hs@nc{\ifhs@lst@lastwas@charkeep@\else\hs@lst@lastwas@character@false\fi}

% modify lst-literate routine to apply to the mechanism
\def\lst@Literate#1#2#3{%
\ifx\relax#2\@empty\else
\lst@CArgX #1\relax\lst@CDef\relax
  {\let\lst@next\@empty
  \lst@ifxliterate
  \lst@ifmode\let\lst@next\lst@CArgEmpty\fi
  \fi\ifx\lst@next\@empty
    \ifx\lst@OutputBox\@gobble\else
    \lst@XPrintToken \let\lst@scanmode\lst@scan@m
    \lst@token{#2}\lst@length#3\relax
    \lst@XPrintToken
    \lst@whitespacefalse\hs@nc
    \fi
    \let\lst@next\lst@CArgEmptyGobble
  \fi\lst@next}%
  \@empty% splitter for constants
\expandafter\lst@Literate
\fi
}

% line numbers consumption
% If possible we want to make the line numbers unmarkable, so you can copy
% code without selecting them:
% locally blacklist some numbers
\newif\if@hs@lst@blacklist@is@ghost@
\let\hsblacklistisghost\@hs@lst@blacklist@is@ghost@true
\let\hsblacklistispresent\@hs@lst@blacklist@is@ghost@false
\def\hsblacklistlinenumbers{\@ifstar{\hsblacklistispresent\@hs@lst@blacklistlinenumers}{\hsblacklistisghost\@hs@lst@blacklistlinenumers}}
\def\@hs@lst@blacklistlinenumers#1{\@for\@num:={#1}\do{\expandafter\let\csname hs@lst@nl@blacklist@\@num\endcsname\@empty}}
% TODO: support for non-integer line markers by not adding stuff if ispresent is true?
% we have to keep a different offset for blacklisted and ghost line numbers
% 1. we must keep ranges intact and
% 2. otherwise the line to be blacklisted would repeat
\newcount\c@hs@lst@blacklisted@linenum@counter
\lst@AddToHook{PreInit}{\c@hs@lst@blacklisted@linenum@counter\z@}

\def\hs@lst@num@consume#1{\@ifundefined{hs@lst@nl@blacklist@#1}{\BeginAccSupp{method=escape,ActualText={}}\the\numexpr#1+\c@hs@lst@blacklisted@linenum@counter\EndAccSupp{}}{\if@hs@lst@blacklist@is@ghost@\global\advance\c@hs@lst@blacklisted@linenum@counter\m@ne\fi}}


